# Copy these settings into your hosting provider's secret/environment settings.
# Never commit or publish your real API key.
AI_API_KEY=replace_with_your_provider_key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
HOST=127.0.0.1
PORT=8000
DEMO_MODE=0
NEXORA_DB_PATH=data/nexora.sqlite3
COOKIE_SECURE=0
# Illustrative default only; replace with the institution-approved policy.
ATTENDANCE_THRESHOLD=75
ATTENDANCE_STATUSES=Present,Absent,Excused
ATTENDANCE_COUNTED_STATUSES=Present
